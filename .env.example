# ─────────────────────────────────────────────────────────────────────────────
# MCPHub environment variables
# Copy to `.env` (repo root — read by workers, drizzle-kit, and apps/web).
# Never commit `.env`. All services below have a genuine forever-free tier.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Anon/publishable key. Safe to expose — RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service role key. BYPASSES RLS. Server-side + GitHub Actions only. NEVER ship
# to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ── Postgres (Drizzle) ──────────────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection string.
# IMPORTANT: use the *pooler* URI (port 6543, transaction mode) for the app —
# the free tier caps direct connections around 60. Append ?pgbouncer=true.
# Use the *direct* URI (port 5432) only for running migrations.
DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, used by `pnpm db:migrate` / drizzle-kit only.
DIRECT_DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Upstash Redis ───────────────────────────────────────────────────────────
# console.upstash.com → your database → REST API.
# Free tier = 10,000 commands/day. Cache reads aggressively; never poll.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX...="

# ── GitHub ──────────────────────────────────────────────────────────────────
# Classic PAT with `public_repo` scope (or a fine-grained token with public
# read). Raises the crawler's API budget from 60 to 5,000 requests/hour.
GITHUB_TOKEN="ghp_..."

# ── Resend (weekly digest email) ────────────────────────────────────────────
# resend.com → API Keys. Free tier = 3,000 emails/month.
RESEND_API_KEY="re_..."

# ── Sentry (error tracking) ─────────────────────────────────────────────────
SENTRY_DSN="https://...@o0.ingest.sentry.io/0"

# ── PostHog (product analytics) ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── App ─────────────────────────────────────────────────────────────────────
# Canonical origin. Used for OG images, sitemap, badges, absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Launch-day kill switch. `true` = longer cache TTLs, submissions and the
# realtime ticker disabled, background workers skipped.
LAUNCH_MODE="false"
